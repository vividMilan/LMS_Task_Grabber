/* Sidebar Container */
#taskView QPushButton#syncButton {
    background-color: #f86c1b;
    padding: 6px 20px;
    border-radius: 8px;
    color: white;
}


#taskView QPushButton#syncButton:hover {
    background-color: #e75907;
}

#chip {
    background-color: #ffe76920;
    border-radius: 12px;
    margin: 0px;
}

#chip QLabel {
    color: #E2E8F0;
    font-size: 12px;
    font-weight: 500;
}


QFrame#completedFrame {
    background-color: #d4d4d4;
    padding: 10px;
    border-radius: 12px;
}


